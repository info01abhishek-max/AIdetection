# Supabase Cloud Storage Configuration
# Copy this file to .env and fill in your Supabase credentials

# Supabase Project URL (found in Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (found in Settings > API) - KEEP SECRET!
# This key has full admin access and should ONLY be used on backend servers
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Supabase Anon Key (found in Settings > API) - Safe for frontend
SUPABASE_ANON_KEY=your-anon-key-here

# Storage Bucket Names (create these in Supabase Dashboard > Storage)
SUPABASE_BUCKET_PHOTO=photo-analyses
SUPABASE_BUCKET_VIDEO=video-analyses
SUPABASE_BUCKET_AUDIO=audio-analyses
SUPABASE_BUCKET_TEXT=text-analyses

# Local Processing Directories (keep minimal for temp processing)
LOCAL_TEMP_DIR=./temp
MAX_LOCAL_TEMP_AGE_HOURS=24

# Backend Ports (for reference)
# Photo: 8002
# Video: 8001
# Audio: 8000
# Text: 8003